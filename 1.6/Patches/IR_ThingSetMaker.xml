<?xml version="1.0" encoding="UTF-8"?>

<Patch>
	<Operation Class="PatchOperationConditional">
		<xpath>Defs/ThingSetMakerDef[defName="MapGen_AncientTempleContents"]/root[@Class="ThingSetMaker_Sum"]</xpath>
		<match Class="PatchOperationAdd">
			<xpath>Defs/ThingSetMakerDef[defName="MapGen_AncientTempleContents"]/root/options</xpath>
			<value>
        		<li>
        		  <chance>0.15</chance>
        		  <thingSetMaker Class="ThingSetMaker_StackCount">
        		    <fixedParams>
        		      <filter>
        		        <thingDefs>
        		          <li>MechReinforcer</li>
        		        </thingDefs>
        		      </filter>
        		      <countRange>1~3</countRange>
        		    </fixedParams>
        		  </thingSetMaker>
        		</li>
				<li>
					<chance>0.0001</chance>
					<thingSetMaker Class="ThingSetMaker_StackCount">
						<fixedParams>
							<filter>
								<thingDefs>
									<li>MechReinforcer</li>
								</thingDefs>
							</filter>
							<countRange>23~47</countRange>
						</fixedParams>
					</thingSetMaker>
				</li>
			</value>
		</match>
		<nomatch Class="PatchOperationConditional">
			<xpath>Defs/ThingSetMakerDef[defName="MapGen_AncientTempleContents"]/root[@Class="ThingSetMaker_RandomOption"]</xpath>
			<match Class="PatchOperationAdd">
				<xpath>Defs/ThingSetMakerDef[defName="MapGen_AncientTempleContents"]/root/options</xpath>
				<value>
        			<li>
        			  <weight>0.3</weight>
        			  <thingSetMaker Class="ThingSetMaker_StackCount">
        			    <fixedParams>
        			      <filter>
        			        <thingDefs>
        			          <li>MechReinforcer</li>
        			        </thingDefs>
        			      </filter>
        			      <countRange>1~3</countRange>
        			    </fixedParams>
        			  </thingSetMaker>
        			</li>
					<li>
						<weight>0.0003</weight>
						<thingSetMaker Class="ThingSetMaker_StackCount">
							<fixedParams>
								<filter>
									<thingDefs>
										<li>MechReinforcer</li>
									</thingDefs>
								</filter>
								<countRange>23~47</countRange>
							</fixedParams>
						</thingSetMaker>
					</li>
				</value>
			</match>
		</nomatch>
	</Operation>

	
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingSetMakerDef[defName="MapGen_AncientComplexRoomLoot_Default"]/root/options</xpath>
		<value>
			<li>
				<weight>0.1</weight>
				<thingSetMaker Class="ThingSetMaker_StackCount">
					<fixedParams>
						<filter>
							<thingDefs>
								<li>MechReinforcer</li>
							</thingDefs>
						</filter>
						<countRange>1~3</countRange>
					</fixedParams>
				</thingSetMaker>
			</li>
		</value>
	</Operation>
</Patch>